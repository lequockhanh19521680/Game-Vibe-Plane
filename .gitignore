# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Node modules
node_modules/
*/node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
# jspm_packages/ # Assuming jspm is not used

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/) - Keep if Parcel might be used
.cache
.parcel-cache

# next.js build output - Remove if Next.js is not used
# .next

# nuxt.js build output - Remove if Nuxt.js is not used
# .nuxt

# vuepress build directory - Remove if VuePress is not used
# .vuepress/dist

# Serverless directories (often specific to backend)
# Keep if serverless framework might be used at root, otherwise move to backend/.gitignore
.serverless/

# FuseBox cache - Remove if FuseBox is not used
# .fusebox/

# DynamoDB Local files (often specific to backend)
# Keep if DynamoDB local might be used at root, otherwise move to backend/.gitignore
.dynamodb/

# TernJS port file - Remove if TernJS is not used
# .tern-port

# Stores VSCode versions used for testing VSCode extensions - Remove if not developing VSCode extensions
# .vscode-test

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Build outputs (Common names, adjust if needed)
dist/
build/
out/

# Temporary files - Removed /tmp/ as it's too broad
# tmp/
# temp/

# AWS deployment files (usually backend specific)
# .aws/ # Move to backend/.gitignore if only used there

# Backup files
*.backup
*.bak

# Configuration overrides
config.local.js
settings.local.js

