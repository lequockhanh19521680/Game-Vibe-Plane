{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$",
      "description": "Unique user identifier"
    },
    "avatar": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["predefined", "custom"],
          "description": "Avatar type"
        }
      },
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "predefined" },
            "category": {
              "type": "string",
              "enum": ["space", "animals", "fantasy", "gaming"],
              "description": "Avatar category"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$",
              "description": "Avatar ID within category"
            },
            "emoji": {
              "type": "string",
              "pattern": "^.{1,4}$",
              "description": "Emoji representation"
            },
            "name": {
              "type": "string",
              "maxLength": 50,
              "description": "Avatar name"
            }
          },
          "required": ["type", "category", "id", "emoji", "name"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "custom" },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://.*\\.(jpg|jpeg|png|gif)$",
              "description": "Avatar image URL"
            },
            "s3Key": {
              "type": "string",
              "maxLength": 1024,
              "description": "S3 object key"
            },
            "uploadedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Upload timestamp"
            },
            "fileType": {
              "type": "string",
              "enum": ["image/jpeg", "image/jpg", "image/png", "image/gif"],
              "description": "File MIME type"
            },
            "fileSize": {
              "type": "number",
              "minimum": 1,
              "maximum": 2097152,
              "description": "File size in bytes"
            }
          },
          "required": ["type", "url"],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["userId", "avatar"],
  "additionalProperties": false
}