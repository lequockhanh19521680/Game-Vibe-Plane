{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$",
      "description": "Unique user identifier"
    },
    "username": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20,
      "pattern": "^[a-zA-Z0-9_\\s-]+$",
      "description": "Player display name"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000,
      "description": "Game score"
    },
    "survivalTime": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400,
      "description": "Survival time in seconds"
    },
    "deathCause": {
      "type": "string",
      "enum": [
        "asteroid collision",
        "missile collision",
        "black hole collision",
        "laser collision",
        "laser mine collision",
        "plasma field burn",
        "crystal cluster collision",
        "lightning strike",
        "unknown"
      ],
      "description": "Cause of player death"
    },
    "fingerprint": {
      "type": "string",
      "maxLength": 128,
      "description": "Device fingerprint for duplicate detection"
    },
    "userAgent": {
      "type": "string",
      "maxLength": 512,
      "description": "Browser user agent"
    },
    "clientIP": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$|^(?:[0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}$",
      "description": "Client IP address"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Submission timestamp"
    }
  },
  "required": ["userId", "username", "score", "survivalTime"],
  "additionalProperties": false
}