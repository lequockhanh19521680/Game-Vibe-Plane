{
  "name": "game-vibe-plane-backend",
  "version": "2.0.0",
  "description": "Serverless backend for Game Vibe Plane with real-time leaderboards and avatar system",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "deploy": "serverless deploy --stage dev --config serverless-refactored.yml",
    "deploy:staging": "serverless deploy --stage staging --config serverless-refactored.yml",
    "deploy:prod": "serverless deploy --stage prod --config serverless-refactored.yml",
    "deploy:legacy": "serverless deploy --stage dev",
    "dev": "serverless offline start --config serverless-refactored.yml",
    "dev:legacy": "serverless offline start",
    "remove": "serverless remove --stage dev --config serverless-refactored.yml",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/**/*.js",
    "validate": "npm run lint && npm run test",
    "logs": "serverless logs -f submitScore --tail --config serverless-refactored.yml",
    "invoke:local": "serverless invoke local --config serverless-refactored.yml",
    "package": "serverless package --config serverless-refactored.yml",
    "info": "serverless info --config serverless-refactored.yml"
  },
  "dependencies": {
    "aws-sdk": "^2.1490.0",
    "axios": "^1.6.0",
    "uuid": "^9.0.1",
    "joi": "^17.9.2",
    "sharp": "^0.32.1",
    "mime-types": "^2.1.35",
    "aws-xray-sdk-core": "^3.5.1"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-esbuild": "^1.45.1",
    "serverless-offline": "^13.3.0",
    "serverless-dynamodb-local": "^0.2.40",
    "serverless-plugin-tracing": "^2.0.0",
    "jest": "^29.7.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.1.0",
    "@types/aws-lambda": "^8.10.114",
    "aws-sdk-mock": "^5.8.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "prettier"
    ],
    "env": {
      "node": true,
      "es2022": true,
      "jest": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "node/no-unpublished-require": "off",
      "node/no-missing-require": "off"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  },
  "keywords": [
    "serverless",
    "aws",
    "lambda",
    "dynamodb",
    "websocket",
    "s3",
    "game",
    "leaderboard",
    "avatar",
    "real-time"
  ],
  "author": "Game Vibe Plane Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/game-vibe-plane"
  },
  "bugs": {
    "url": "https://github.com/your-org/game-vibe-plane/issues"
  },
  "homepage": "https://vibeplane.io"
}