{
  "name": "game-vibe-plane-infrastructure",
  "version": "2.0.0",
  "description": "AWS Infrastructure for Game Vibe Plane - Optimized for 1-1000 users",
  "main": "index.js",
  "scripts": {
    "install:all": "npm install && cd ../frontend && npm install",
    "dev": "serverless offline start",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:staging": "serverless deploy --stage staging",
    "deploy:prod": "serverless deploy --stage prod",
    "remove:dev": "serverless remove --stage dev",
    "remove:staging": "serverless remove --stage staging",
    "remove:prod": "serverless remove --stage prod",
    "logs": "serverless logs -f endGameSession -t --stage dev",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "format": "prettier --write src/",
    "validate": "npm run lint && npm run test",
    "warmup": "serverless warmup --stage prod",
    "info": "serverless info",
    "metrics": "serverless metrics"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/client-apigatewaymanagementapi": "^3.450.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "@aws-sdk/util-dynamodb": "^3.450.0",
    "uuid": "^9.0.1",
    "joi": "^17.11.0",
    "geoip-lite": "^1.4.8"
  },
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0",
    "serverless-plugin-warmup": "^8.2.1",
    "jest": "^29.7.0",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.0",
    "@types/jest": "^29.5.8",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "game",
    "leaderboard",
    "real-time",
    "aws",
    "serverless",
    "websocket",
    "dynamodb",
    "lambda"
  ],
  "author": "Game Vibe Plane Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lequockhanh19521680/game-vibe-plane.git"
  }
}